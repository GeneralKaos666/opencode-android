+      FFF_LIBC: item.os === "linux" ? `'${item.abi === "android" ? "musl" : (item.abi ?? "gnu")}'` : "undefined",
+      // Android (bionic): embed the musl-static opentui build; its only NEEDED is
+      // bare libc.so, which Android's linker resolves to bionic. Never "android":
+      // the runtime loader throws for anything but unset/glibc/musl.
+      ...(item.os === "linux" ? { "process.env.OPENTUI_LIBC": JSON.stringify(item.abi === "android" ? "musl" : (item.abi ?? "glibc")) } : {}),
     },
   })
 
@@ -330,3 +342,19 @@ function targetName(item: (typeof allTargets)[number]) {
     .filter(Boolean)
     .join("-")
 }
+
+function resolveParcelWatcherAndroid() {
+  const root = path.resolve(import.meta.dirname, "../../..")
+  const store = new Bun.Glob(
+    "@parcel+watcher-android-arm64@*/node_modules/@parcel/watcher-android-arm64/watcher.node",
+  )
+  for (const match of store.scanSync({ cwd: path.join(root, "node_modules/.bun"), absolute: true })) return match
+  const flat = path.join(root, "node_modules/@parcel/watcher-android-arm64/watcher.node")
+  if (!existsSync(flat)) {
+    throw new Error(
+      "Missing @parcel/watcher-android-arm64: run bun install --os=\"*\" --cpu=\"*\" " +
+        "so the android binding is on disk before building",
+    )
+  }
+  return flat
+}
